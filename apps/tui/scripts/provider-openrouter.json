  "commands": [
    { "type": "captureFrame", "label": "openrouter-00-initial" },
    { "type": "keypress", "key": "return" },
    { "type": "waitForFrame", "contains": "Select LLM Provider", "timeout": 5000 },
    { "type": "captureFrame", "label": "openrouter-01-provider-select" },
    { "type": "assertFrameContains", "value": "OpenRouter" },
    { "type": "keypress", "key": "down" },
    { "type": "wait", "ms": 50 },
    { "type": "keypress", "key": "return" },
    { "type": "waitForFrame", "contains": "Enter API Key", "timeout": 5000 },
    { "type": "captureFrame", "label": "openrouter-02-key-entry" },
    { "type": "text", "value": "or-sk-test-key-with_special_chars-ABC_123" },
    { "type": "wait", "ms": 100 },
    { "type": "captureFrame", "label": "openrouter-03-key-typed" },
    { "type": "keypress", "key": "return" },
    { "type": "waitForFrame", "contains": "Select Model", "timeout": 10000 },
    { "type": "captureFrame", "label": "openrouter-04-model-select" },
    { "type": "assertFrameContains", "value": "OpenRouter GPT-4o" },
    { "type": "assertFrameContains", "value": "OpenRouter Claude Sonnet" },
    { "type": "assertFrameContains", "value": "OpenRouter Mistral Small" },
    { "type": "assertFrameContains", "value": "OpenRouter DeepSeek V3" },
    { "type": "assertFrameContains", "value": "OpenRouter Llama 3.1 70B" },
    { "type": "assertFrameContains", "value": "FREE" },
    { "type": "keypress", "key": "return" },
    { "type": "waitForFrame", "contains": "Configuration summary", "timeout": 5000 },
    { "type": "captureFrame", "label": "openrouter-05-confirm" },
    { "type": "keypress", "key": "return" },
    { "type": "waitForFrame", "contains": "Configuration saved", "timeout": 10000 },
    { "type": "captureFrame", "label": "openrouter-06-done" }
  ]
